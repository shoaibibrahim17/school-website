---
import '../styles/global.css';
import LenisScroll from '../components/react/LenisScroll.jsx';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mother's Care High School - Excellence in Education",
  description = "Mother's Care High School - Providing quality education with a focus on academic excellence, character development, and holistic growth. Admissions open for 2026-27."
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <link rel="icon" type="image/svg+xml" href={(import.meta.env.BASE_URL + '/logo.svg').replace('//', '/')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="keywords" content="school, education, admissions, SSC, academic excellence, Adilabad" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="font-sans antialiased bg-white text-gray-900">
    <LenisScroll client:load>
      <slot />
    </LenisScroll>
  </body>
</html>
