---
import GalleryContent from './react/GalleryContent.jsx';
---

<section id="gallery" class="py-12 lg:py-28 bg-gradient-to-br from-slate-50 via-white to-brand-50 relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src="./logo.svg" alt="" class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[850px] opacity-10 object-contain" aria-hidden="true" />
  </div>
  <div class="absolute top-20 left-10 w-32 sm:w-44 lg:w-64 h-32 sm:h-44 lg:h-64 bg-brand-100/30 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-32 sm:w-44 lg:w-64 h-32 sm:h-44 lg:h-64 bg-teal-100/30 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-14 lg:mb-18">
      <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-700 font-semibold text-sm rounded-full mb-4">
        Our Gallery
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4">
        Moments of <span class="text-brand-600">Excellence</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Explore our vibrant campus life through these glimpses of academic activities, sports events, and cultural programs.
      </p>
    </div>

    <GalleryContent client:load />

    <div class="text-center mt-12">
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 px-8 py-4 bg-white text-brand-600 font-semibold rounded-xl border-2 border-brand-200 hover:bg-brand-50 hover:border-brand-500 transition-all duration-300 hover:-translate-y-1"
      >
        <span>Request Photo Gallery</span>
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
