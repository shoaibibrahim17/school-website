---
import PrincipalContent from './react/PrincipalContent.jsx';
---

<section id="principal" class="py-12 lg:py-28 bg-gradient-to-br from-white via-teal-50/60 to-amber-50/60 relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src={(import.meta.env.BASE_URL + '/logo.svg').replace('//', '/')} alt="" class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[800px] opacity-10 object-contain" aria-hidden="true" />
  </div>
  <div class="absolute top-20 left-10 w-32 sm:w-44 lg:w-64 h-32 sm:h-44 lg:h-64 bg-teal-100/50 rounded-full blur-3xl"></div>
  <div class="absolute bottom-20 right-10 w-32 sm:w-44 lg:w-64 h-32 sm:h-44 lg:h-64 bg-amber-100/50 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <PrincipalContent client:load />
  </div>
</section>
