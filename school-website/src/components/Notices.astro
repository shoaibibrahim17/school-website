---
import NoticesContent from './react/NoticesContent.jsx';
---

<section id="notices" class="py-12 lg:py-28 bg-gradient-to-br from-white via-orange-50/40 to-blue-50/60 relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src={(import.meta.env.BASE_URL + '/logo.svg').replace('//', '/')} alt="" class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[800px] opacity-10 object-contain" aria-hidden="true" />
  </div>
  <div class="absolute top-0 right-0 w-40 sm:w-64 lg:w-96 h-40 sm:h-64 lg:h-96 bg-orange-100/50 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-40 sm:w-64 lg:w-96 h-40 sm:h-64 lg:h-96 bg-blue-100/50 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="scroll-reveal-item text-center mb-14 lg:mb-18">
      <span class="inline-block px-4 py-1.5 bg-orange-50 text-orange-700 font-semibold text-sm rounded-full mb-4 border border-orange-100">
        Latest Updates
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4">
        Stay Connected with <span class="text-orange-600">School Updates</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Important announcements, events, and updates for our parents and students.
      </p>
    </div>

    <NoticesContent client:load />
  </div>
</section>
