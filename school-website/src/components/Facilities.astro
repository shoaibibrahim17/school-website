---
import FacilitiesContent from './react/FacilitiesContent.jsx';
---

<section id="facilities" class="py-12 lg:py-28 bg-gray-50 relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src={(import.meta.env.BASE_URL + '/logo.svg').replace('//', '/')} alt="" class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[900px] opacity-10 object-contain" aria-hidden="true" />
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="scroll-reveal-item text-center mb-14 lg:mb-18">
      <span class="inline-block px-4 py-1.5 bg-emerald-50 text-emerald-700 font-semibold text-sm rounded-full mb-4 border border-emerald-100">
        Our Facilities
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4">
        Campus &amp; Facilities <span class="text-emerald-600">Designed for Growth</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        Every corner of our campus is thoughtfully designed to nurture young minds. From our Playway pre-primary program to advanced digital classrooms, every facility supports your child's holistic development.
      </p>
    </div>

    <FacilitiesContent client:load />

    <div class="text-center mt-12">
      <a
        href="#contact"
        class="group inline-flex items-center gap-2 px-8 py-4 bg-emerald-600 text-white font-semibold rounded-xl hover:bg-emerald-700 transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-md"
      >
        <span>Schedule a Campus Tour</span>
        <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>
