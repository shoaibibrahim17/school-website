---
import AboutContent from './react/AboutContent.jsx';
---

<section id="about" class="py-20 lg:py-28 bg-gradient-to-b from-white to-slate-50 relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src={import.meta.env.BASE_URL + 'logo.svg'} alt="" class="w-[400px] sm:w-[600px] lg:w-[800px] opacity-[0.025] object-contain" aria-hidden="true" />
  </div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-brand-100/30 rounded-full blur-3xl"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-teal-100/30 rounded-full blur-3xl"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-14 lg:mb-18">
      <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-700 font-semibold text-sm rounded-full mb-4">
        About Us
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold text-gray-900 mb-4">
        A Home for Learning <span class="text-brand-600">Since 2011</span>
      </h2>
      <p class="text-lg text-gray-600 max-w-3xl mx-auto leading-relaxed">
        At Mother's Care High School, we believe education is not just about textbooks and exams. It is about nurturing curious minds, building strong character, and creating a warm, supportive environment where every child feels valued. Our English Medium curriculum, dedicated faculty, and child-first approach make us the trusted choice for parents in Adilabad.
      </p>
    </div>

    <AboutContent client:load />
  </div>
</section>
