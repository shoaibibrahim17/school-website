---
import ContactContent from './react/ContactContent.jsx';
---

<section id="contact" class="py-20 lg:py-28 bg-gradient-to-br from-slate-900 via-brand-900 to-teal-900 text-white relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img src={(import.meta.env.BASE_URL + '/logo.svg').replace('//', '/')} alt="" class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[900px] opacity-[0.04] brightness-0 invert object-contain" aria-hidden="true" />
  </div>
  <div class="absolute inset-0 opacity-10">
    <div class="absolute top-0 left-0 w-40 sm:w-64 lg:w-96 h-40 sm:h-64 lg:h-96 bg-brand-500 rounded-full blur-3xl"></div>
    <div class="absolute bottom-0 right-0 w-40 sm:w-64 lg:w-96 h-40 sm:h-64 lg:h-96 bg-teal-500 rounded-full blur-3xl"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-64 sm:w-80 lg:w-[600px] h-64 sm:h-80 lg:h-[600px] bg-brand-600/20 rounded-full blur-3xl"></div>
  </div>

  <div class="absolute inset-0 opacity-[0.04]" style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 60px 60px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="text-center mb-14 lg:mb-18">
      <span class="inline-block px-4 py-1.5 bg-white/15 text-white font-semibold text-sm rounded-full mb-4 backdrop-blur-sm">
        Contact Us
      </span>
      <h2 class="text-3xl lg:text-4xl xl:text-5xl font-bold mb-4">
        Enroll Your Child at Mother's Care
      </h2>
      <p class="text-lg text-white/70 max-w-3xl mx-auto leading-relaxed">
        Admissions open for LKG to Class 10. Give your child the gift of quality education in a nurturing English Medium environment. Call us at <a href="tel:9154408383" class="text-white underline decoration-brand-400 hover:decoration-white transition-colors font-semibold">9154408383</a> or fill the form below.
      </p>
    </div>

    <ContactContent client:load />
  </div>
</section>
