const academics = [
  { name: "Curriculum", href: "#facilities" },
  { name: "Subjects", href: "#facilities" },
  { name: "Examinations", href: "#notices" },
  { name: "Results", href: "#notices" }
];

const contactInfo = [
  { icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z", text: "Masood Chowk, Adilabad, Telangana" },
