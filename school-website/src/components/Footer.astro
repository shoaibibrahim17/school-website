---
const currentYear = new Date().getFullYear();

const quickLinks = [
  { name: "About Us", href: "#about" },
  { name: "Admissions", href: "#contact" },
  { name: "Academics", href: "#facilities" },
  { name: "Facilities", href: "#facilities" },
  { name: "Gallery", href: "#gallery" },
  { name: "Contact", href: "#contact" }
];

const academics = [
  { name: "Curriculum", href: "#facilities" },
  { name: "Subjects", href: "#facilities" },
  { name: "Examinations", href: "#notices" },
  { name: "Results", href: "#notices" }
];

const contactInfo = [
  { icon: "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z", text: "Masood Chowk, Adilabad, Telangana" },
  { icon: "M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z", text: "9154408383", href: "tel:9154408383" },
  { icon: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z", text: "motherscarehighschooladilabad@gmail.com" }
];

const socialLinks = [
  { icon: "M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84", href: "#", label: "Facebook" },
  { icon: "M23 3a10.9 10.9 0 01-3.14 1.53 4.48 4.48 0 00-7.86 3v1A10.66 10.66 0 013 4s-4 9 5 13a11.64 11.64 0 01-7 2c9 5 20 0 20-11.5a4.5 4.5 0 00-.08-.83A7.72 7.72 0 0023 3z", href: "#", label: "Twitter" },
  { icon: "M16 11.37A4 4 0 1112.63 8 4 4 0 0116 11.37z M17.5 6.5h.01M7 2h10a5 5 0 015 5v10a5 5 0 01-5 5H7a5 5 0 01-5-5V7a5 5 0 015-5z", href: "#", label: "Instagram" },
  { icon: "M4 4l11.733 16h4.267l-11.733 -16z M4 20l6.768 -6.768m2.46 -2.46l6.772 -6.772", href: "#", label: "YouTube" }
];
---

<footer class="bg-gray-900 text-white relative overflow-hidden">
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none overflow-hidden">
    <img
      src={import.meta.env.BASE_URL + '/logo.svg'}
      alt=""
      class="w-[140px] sm:w-[300px] lg:w-[500px] 2xl:w-[900px] opacity-[0.03] object-contain"
      aria-hidden="true"
    />
  </div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-16 relative z-10">
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
      <div class="lg:col-span-1">
        <div class="flex items-center gap-4 mb-4">
          <div class="w-16 h-16 bg-gradient-to-br from-brand-500 to-brand-700 rounded-2xl flex items-center justify-center shadow-lg shadow-brand-800/30 ring-2 ring-brand-400/20">
            <img src={import.meta.env.BASE_URL + '/logo.svg'} alt="Logo" class="w-10 h-10 brightness-0 invert" />
          </div>
          <div>
            <span class="text-xl font-bold block">Mother's Care</span>
            <span class="text-brand-400 text-xs font-semibold tracking-wider uppercase">Est. 2011</span>
          </div>
        </div>
        <p class="text-gray-400 mb-4 text-sm leading-relaxed">
          <span class="italic text-brand-400">&ldquo;While you take care of the world, we take care of your children&rdquo;</span>
        </p>
        <p class="text-gray-400 mb-6 text-sm leading-relaxed">
          Premier English Medium SSC affiliated school in Adilabad. Nurturing young minds with care, purpose, and academic excellence since 2011.
        </p>
        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              class="w-10 h-10 bg-gray-800 rounded-xl flex items-center justify-center hover:bg-brand-600 transition-all duration-300 hover:scale-110"
              aria-label={social.label}
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d={social.icon} />
              </svg>
            </a>
          ))}
        </div>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Quick Links</h3>
        <ul class="space-y-3">
          {quickLinks.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center"
              >
                <svg class="w-4 h-4 mr-2 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Academics</h3>
        <ul class="space-y-3">
          {academics.map((link) => (
            <li>
              <a
                href={link.href}
                class="text-gray-400 hover:text-white hover:translate-x-1 transition-all duration-200 inline-flex items-center"
              >
                <svg class="w-4 h-4 mr-2 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                {link.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-lg font-semibold mb-4 text-white">Contact Info</h3>
        <ul class="space-y-4">
          {contactInfo.map((info) => (
            <li class="flex items-start gap-3">
              <div class="w-8 h-8 bg-gray-800 rounded-lg flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-4 h-4 text-brand-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={info.icon} />
                </svg>
              </div>
              {info.href ? (
                <a href={info.href} class="text-gray-400 text-sm hover:text-white transition-colors">{info.text}</a>
              ) : (
                <span class="text-gray-400 text-sm">{info.text}</span>
              )}
            </li>
          ))}
        </ul>

        <div class="mt-6 pt-6 border-t border-gray-800">
          <h4 class="font-semibold mb-2 text-sm text-gray-300">Office Hours</h4>
          <p class="text-gray-400 text-sm">Mon - Sat: 8:00 AM - 4:00 PM</p>
        </div>
      </div>
    </div>

    <div class="mt-12 pt-8 border-t border-gray-800">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="text-gray-400 text-sm text-center md:text-left">
          &copy; {currentYear} Mother's Care High School. All rights reserved.
        </p>
        <div class="flex flex-wrap justify-center gap-4 sm:gap-6 text-sm">
          <a href="#" class="text-gray-400 hover:text-white transition-colors">Privacy Policy</a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">Terms of Service</a>
          <a href="#" class="text-gray-400 hover:text-white transition-colors">Sitemap</a>
        </div>
      </div>
    </div>
  </div>
</footer>
