---

<section class="relative z-20 pb-12 lg:pb-24 -mt-6 sm:-mt-12 lg:-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="scroll-reveal-item relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border-4 sm:border-8 border-white bg-white group">
      <div class="absolute inset-0 bg-brand-900/10 group-hover:bg-transparent transition-colors duration-500 z-10 pointer-events-none"></div>
      
      {/* Assuming the image is saved as 'school-building.jpg' in the public folder */}
      <img 
        src="/school-building.jpg" 
        alt="Mother's Care High School Campus" 
        class="w-full h-auto max-h-[600px] object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out" 
      />
      
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/80 via-black/40 to-transparent p-6 sm:p-8 pt-20 z-20">
        <div class="flex items-center gap-3 mb-2">
          <span class="flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span class="text-emerald-300 text-xs sm:text-sm font-semibold uppercase tracking-wider">Our Campus</span>
        </div>
        <h3 class="font-heading text-xl sm:text-3xl font-bold text-white mb-2">Welcome to Mother's Care High School</h3>
        <p class="text-gray-200 text-sm sm:text-base max-w-2xl">A modern infrastructure designed to provide a safe, inspiring, and engaging environment for every child.</p>
      </div>
    </div>
  </div>
</section>
