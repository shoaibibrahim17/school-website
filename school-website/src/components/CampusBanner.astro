---

<section class="hidden lg:block relative z-20 pb-12 lg:pb-24 -mt-12 lg:-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="scroll-reveal-item relative rounded-3xl overflow-hidden shadow-2xl border-8 border-white bg-white group">
      <img 
        src="/school-building.jpg" 
        alt="Mother's Care High School Campus" 
        class="w-full h-auto max-h-[600px] object-cover object-center transform group-hover:scale-105 transition-transform duration-700 ease-out" 
      />
      
      <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent p-8 pt-24 z-20">
        <div class="flex items-center gap-3 mb-2">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-white"></span>
          </span>
          <span class="text-white/80 text-sm font-semibold uppercase tracking-wider">Our Campus</span>
        </div>
        <h3 class="font-heading text-3xl font-bold text-white mb-2">Welcome to Mother's Care High School</h3>
        <p class="text-gray-200 text-base max-w-2xl">A modern campus designed to provide a safe, inspiring environment for every child.</p>
      </div>
    </div>
  </div>
</section>
