---
import AnimatedCounter from './react/AnimatedCounter.jsx';

const schoolName = "Mother's Care High School";
const tagline = "Nurturing Future Leaders with Excellence";

const stats = [
  { value: 20, label: "Years of Excellence", suffix: "+" },
  { value: 1200, label: "Happy Students", suffix: "+" },
  { value: 45, label: "Expert Teachers", suffix: "+" },
  { value: 95, label: "Pass Rate", suffix: "%" },
];
---

<section id="hero" class="relative min-h-screen flex items-center pt-20 overflow-hidden bg-white">
  <div class="absolute inset-0 bg-gradient-to-br from-slate-50 via-white to-brand-50 z-0"></div>

  <div class="absolute top-40 right-10 w-72 h-72 bg-brand-200/30 rounded-full blur-3xl animate-float"></div>
  <div class="absolute bottom-20 left-10 w-96 h-96 bg-teal-200/30 rounded-full blur-3xl animate-float-delayed"></div>

  <div class="absolute inset-0 opacity-[0.015] z-1" style="background-image: linear-gradient(#4f46e5 1px, transparent 1px), linear-gradient(90deg, #4f46e5 1px, transparent 1px); background-size: 50px 50px;"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 relative z-10">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <div class="text-center lg:text-left">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-brand-50 rounded-full mb-6">
          <span class="w-1.5 h-1.5 bg-brand-600 rounded-full"></span>
          <span class="text-brand-700 font-semibold text-sm">SSC Affiliated School</span>
        </div>

        <h1 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-bold text-gray-900 leading-tight mb-6">
          <span class="block">Building</span>
          <span class="block text-brand-600">Bright Futures</span>
          <span class="block text-gray-800">for Tomorrow</span>
        </h1>

        <p class="text-lg lg:text-xl text-gray-600 mb-8 max-w-xl mx-auto lg:mx-0 leading-relaxed">
          {tagline}. Since 2011, we have been committed to providing quality education that empowers students to achieve their full potential and become responsible citizens.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start">
          <a href="#contact" class="group inline-flex items-center justify-center px-8 py-4 bg-brand-600 text-white font-bold rounded-xl hover:bg-brand-700 transition-all duration-300 hover:-translate-y-1 shadow-sm hover:shadow-md">
            <span>Enroll Now</span>
            <svg class="w-5 h-5 ml-2 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a href="#about" class="group inline-flex items-center justify-center px-8 py-4 bg-white text-gray-700 font-semibold rounded-xl border-2 border-gray-200 hover:border-brand-500 hover:text-brand-600 transition-all duration-300 hover:-translate-y-1">
            <svg class="w-5 h-5 mr-2 text-gray-400 group-hover:text-brand-600 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            </svg>
            <span>Learn More</span>
          </a>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-6 mt-12 pt-8 border-t border-gray-100">
          {stats.map((stat, index) => (
            <AnimatedCounter
              client:visible
              value={stat.value}
              label={stat.label}
              suffix={stat.suffix || ''}
            />
          ))}
        </div>
      </div>

      <div class="relative hidden lg:block">
        <div class="relative">
          <div class="absolute inset-0 bg-brand-600 rounded-3xl rotate-2 opacity-20 blur-xl"></div>

          <div class="relative bg-white rounded-3xl p-2 shadow-xl hover:scale-[1.02] transition-transform duration-500">
            <div class="aspect-[4/3] bg-gradient-to-br from-brand-50 via-white to-teal-50 rounded-2xl overflow-hidden relative">
              <img
                src="https://images.unsplash.com/photo-1523050854058-8df90110c9f1?w=800&h=600&fit=crop"
                alt="Students in classroom"
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent"></div>

              <div class="absolute bottom-6 left-6 right-6">
                <div class="bg-white/95 rounded-xl p-4 shadow-lg border border-gray-100">
                  <div class="flex items-center gap-4">
                    <div class="w-12 h-12 bg-brand-600 rounded-lg flex items-center justify-center">
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
                      </svg>
                    </div>
                    <div>
                      <p class="font-bold text-gray-800">Quality Education</p>
                      <p class="text-sm text-gray-500">Holistic Development</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="absolute -top-4 -right-4 bg-white rounded-2xl p-4 shadow-lg animate-float border border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-teal-50 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-gray-800">ISO 9001:2015</p>
              <p class="text-sm text-gray-500">Certified</p>
            </div>
          </div>
        </div>

        <div class="absolute -bottom-4 -left-4 bg-white rounded-2xl p-4 shadow-lg animate-float-delayed border border-gray-100">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 bg-brand-50 rounded-full flex items-center justify-center">
              <svg class="w-6 h-6 text-brand-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <div>
              <p class="font-bold text-gray-800">SSC Board</p>
              <p class="text-sm text-gray-500">Affiliated</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  @keyframes float-delayed {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }

  .animate-float {
    animation: float 8s ease-in-out infinite;
  }

  .animate-float-delayed {
    animation: float-delayed 10s ease-in-out infinite;
  }
</style>
